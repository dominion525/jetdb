{
  // src/ の TS を、assets/ に 1 ファイルずつ ES モジュールの JS として出す（バンドラーは使わない）
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "rootDir": "src",
    "outDir": "assets",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "removeComments": false,
    "newLine": "lf"
    // ページは jetdb-wasm を CDN から読む（import map）。型は devDependency の jetdb-wasm（同じ版）から解決する
  },
  "include": ["src"]
}
